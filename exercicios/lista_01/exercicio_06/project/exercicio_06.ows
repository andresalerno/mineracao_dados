		<properties node_id="1" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 2, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x11\x0b\x00\x00\x01\x14\x00\x00\x14\x9d\x00\x00\x03\xcc\x00\x00\x111\x00\x00\x01O\x00\x00\x14w\x00\x00\x03\xa6\x00\x00\x00\x02\x00\x00\x00\x00\x07\x80\x00\x00\x111\x00\x00\x01O\x00\x00\x14w\x00\x00\x03\xa6', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}, {'name': 'conexao_maria_db', 'script': 'import pandas as pd\nfrom sqlalchemy import create_engine\nfrom Orange.data.pandas_compat import table_from_frame\n\n# Dados de conexão\nhost = "127.0.0.1"\nport = 3307\nuser = "appuser"\npassword = "SenhaAppForte123"\ndatabase = "appdb"\n\n# Cria conexão\nconnection_url = (\n    f"mysql+pymysql://{user}:{password}@{host}:{port}/{database}"\n)\n\nengine = create_engine(connection_url)\n\n# Consulta\nquery = """\nSELECT *\nFROM cadastro_clientes;\n"""\n\n# MariaDB -&gt; Pandas\ndf = pd.read_sql(query, engine)\n\nprint(df.head())\nprint(f"Registros encontrados: {len(df)}")\n\n# Pandas -&gt; Orange\nout_data = table_from_frame(df)\n\nengine.dispose()', 'filename': None}, {'name': 'python_script', 'script': 'import pandas as pd\nfrom sqlalchemy import create_engine\nfrom Orange.data.pandas_compat import table_from_frame\n\nengine = create_engine("mysql+pymysql://appuser:SenhaAppForte123@127.0.0.1:3307/appdb")\ndf = pd.read_sql("SELECT * FROM cadastro_clientes;", engine)\nout_data = table_from_frame(df)\nengine.dispose()\n', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom sqlalchemy import create_engine\nfrom Orange.data.pandas_compat import table_from_frame\n\nengine = create_engine("mysql+pymysql://appuser:SenhaAppForte123@127.0.0.1:3307/appdb")\ndf = pd.read_sql("SELECT * FROM cadastro_clientes;", engine)\nout_data = table_from_frame(df)\nengine.dispose()\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xaa\x00\x00\x00f\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
